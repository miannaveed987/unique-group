:root {
  --bg:#10100f; --panel:#181816; --gold:#c8a66a; --gold-light:#e3c58e;
  --white:#f4f1eb; --muted:#aaa69e; --line:rgba(255,255,255,.12);
  --serif:'Playfair Display',Georgia,serif; --sans:'DM Sans',Arial,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:85px}
body{background:var(--bg);color:var(--white);font-family:var(--sans);line-height:1.6}
a{color:inherit;text-decoration:none}
.container{width:min(1160px,calc(100% - 48px));margin:auto}
.header{height:86px;position:sticky;top:0;z-index:50;background:rgba(16,16,15,.94);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.nav-wrap{height:100%;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:12px}
.brand-mark{width:42px;height:42px;border:1px solid var(--gold);display:grid;place-items:center;font:600 19px var(--serif);color:var(--gold)}
.brand-mark span{color:var(--white)}
.brand-name{font-size:14px;letter-spacing:2px;font-weight:700;line-height:1.4}
.brand-name b{color:var(--gold);font-weight:500}
.brand-name small{display:block;font-size:8px;letter-spacing:2px;color:var(--muted);font-weight:500}
.nav{display:flex;align-items:center;gap:35px}
.nav>a{font-size:12px;color:#d5d1ca;transition:.25s}
.nav>a:hover{color:var(--gold)}
.nav .nav-contact{border:1px solid var(--gold);padding:12px 19px;color:var(--gold)}
.nav-contact span{margin-left:12px}
.menu-toggle{display:none;background:none;border:0}
.hero{min-height:660px;height:calc(100svh - 86px);max-height:850px;position:relative;display:flex;align-items:center;overflow:hidden}
.hero-bg{position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,10,9,.96) 0%,rgba(10,10,9,.78) 46%,rgba(10,10,9,.22) 100%),linear-gradient(0deg,rgba(10,10,9,.65),transparent 45%),url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=85') center/cover}
.hero-content{position:relative;padding-top:20px}
.eyebrow,.section-label,.overline{font-size:10px;letter-spacing:2.5px;color:var(--gold);font-weight:700}
.eyebrow{display:flex;align-items:center;gap:12px}
.eyebrow span{width:28px;height:1px;background:var(--gold)}
.hero h1{font:500 clamp(64px,9vw,112px)/1.04 var(--serif);letter-spacing:-3px;margin:28px 0}
h1 em,h2 em{color:var(--gold);font-weight:500}
.hero-text{max-width:440px;color:#d0ccc5;font-size:15px;line-height:1.9}
.hero-actions{display:flex;align-items:center;gap:32px;margin-top:36px}
.btn{display:inline-flex;align-items:center;gap:28px;padding:16px 22px;font-size:11px;letter-spacing:.5px;font-weight:700;transition:.3s}
.btn-gold{background:var(--gold);color:#171510}
.btn-gold:hover{background:var(--gold-light);transform:translateY(-3px)}
.text-link{font-size:11px;color:#e4e0d8}
.text-link span{color:var(--gold);padding-left:9px}
.hero-bottom{position:absolute;left:24px;right:24px;bottom:-145px;display:flex;justify-content:space-between;font-size:9px;letter-spacing:2px;color:#c5c0b7}
.hero-side-label{position:absolute;right:25px;top:50%;writing-mode:vertical-rl;font-size:9px;letter-spacing:3px;color:rgba(255,255,255,.55)}
.section{padding:115px 0}
.intro{background:#f0eee8;color:#181816}
.intro-grid{display:grid;grid-template-columns:1fr 2.2fr .8fr;gap:45px}
.intro .section-label{color:#8e7042}
.intro-main h2,.section-heading h2,.contact h2{font:500 clamp(38px,5vw,58px)/1.2 var(--serif);margin:22px 0}
.body-copy{max-width:600px;color:#66645e;font-size:14px;line-height:2}
.under-link{display:inline-block;margin-top:30px;font-size:10px;letter-spacing:1.5px;font-weight:700;border-bottom:1px solid #c8a66a;padding-bottom:8px}
.under-link span{color:#a17b43;margin-left:16px}
.intro-note{align-self:end;padding-bottom:15px}
.gold-line{width:48px;height:2px;background:#b18b53;margin-bottom:22px}
.intro-note p{font:600 25px/1.4 var(--serif);letter-spacing:1px}
.intro-note span{font-size:11px;color:#77736c}
.services{background:#151513}
.section-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:48px}
.section-heading h2{margin:15px 0 0}
.section-heading>p{max-width:280px;font-size:12px;color:var(--muted);line-height:1.9}
.service-grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line)}
.service-card{padding:38px 32px;min-height:310px;position:relative;border-right:1px solid var(--line);transition:.3s}
.service-card:last-child{border:0}
.service-card:hover,.service-card.featured{background:#201e19}
.service-number{position:absolute;right:28px;top:28px;font-size:10px;color:var(--gold)}
.service-icon{font:40px var(--serif);color:var(--gold);margin:12px 0 27px}
.service-card h3{font:500 23px var(--serif);margin-bottom:13px}
.service-card p{font-size:12px;color:var(--muted);line-height:1.9;min-height:68px}
.service-card>a{display:inline-block;margin-top:25px;font-size:9px;letter-spacing:1.3px;color:var(--gold)}
.service-card>a span{margin-left:12px}
.statement{height:480px;position:relative;display:flex;align-items:center;overflow:hidden}
.statement-bg{position:absolute;inset:0;background:linear-gradient(90deg,rgba(12,12,11,.92),rgba(12,12,11,.45)),url('https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1800&q=80') center/cover}
.statement-content{position:relative}
.statement-content>span{font-size:10px;letter-spacing:2px;color:var(--gold)}
.statement h2{font:500 clamp(43px,6vw,70px)/1.2 var(--serif);margin:20px 0 30px}
.projects{background:#f0eee8;color:#181816}
.projects .section-label{color:#967747}
.projects .section-heading>p{color:#77736c}
.project-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.project-card{min-width:0}
.project-image{height:310px;position:relative;display:grid;place-items:center;overflow:hidden;background:#c9c5bb}
.project-image:before{content:"";position:absolute;inset:0;background:linear-gradient(145deg,#b8b2a5,#6f706b 48%,#292d2a);transition:transform .6s}
.project-two .project-image:before{background:linear-gradient(145deg,#d0c8b8,#8d897e 45%,#41413b)}
.project-three .project-image:before{background:linear-gradient(145deg,#c7c2b6,#817c70 48%,#33332f)}
.project-card:hover .project-image:before{transform:scale(1.06)}
.project-image span{position:relative;color:rgba(255,255,255,.75);font-size:9px;letter-spacing:3px;border:1px solid rgba(255,255,255,.5);padding:10px 14px}
.project-info{display:flex;justify-content:space-between;align-items:center;padding:18px 0;border-bottom:1px solid #c9c5bb}
.project-info small{font-size:9px;letter-spacing:1.4px;color:#987747}
.project-info h3{font:500 19px var(--serif);margin-top:5px}
.project-info>span{color:#987747;font-size:20px}
.portfolio-note{text-align:center;color:#827d73;font-size:11px;margin-top:28px}
.team{background:#151513}
.team-heading{margin-top:14px}
.team-heading h2{margin:0}
.team-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.team-card{display:flex;align-items:center;gap:24px;padding:30px;border:1px solid var(--line);background:#191917}
.team-avatar{width:78px;height:78px;flex-shrink:0;border:1px solid var(--gold);display:grid;place-items:center;color:var(--gold);font:26px var(--serif)}
.team-card span{font-size:9px;letter-spacing:1.4px;color:var(--gold)}
.team-card h3{font:500 25px var(--serif);margin:5px 0}
.team-card a{font-size:12px;color:#c8c3ba}
.contact{background:#e9e6de;color:#171714}
.contact .section-label{color:#967747}
.contact-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:100px}
.contact h2{font-size:clamp(48px,6vw,72px);margin:22px 0}
.contact-left>p{max-width:390px;color:#706d65;font-size:13px;line-height:1.9;margin-bottom:28px}
.contact-details{padding-top:40px}
.contact-item{padding:20px 0;border-bottom:1px solid #c9c5bb}
.contact-item span{display:block;font-size:9px;letter-spacing:1.5px;color:#8c7045;margin-bottom:8px}
.contact-item>a,.contact-item p{font-size:16px;color:#25231e;line-height:1.8}
.footer{background:#10100f}
.footer-top{min-height:125px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}
.footer-top>p{font:italic 19px var(--serif);color:var(--gold)}
.back-top{font-size:9px;letter-spacing:1.5px;color:#c8c3ba}
.footer-bottom{min-height:65px;display:flex;justify-content:space-between;align-items:center;color:#858078;font-size:9px;letter-spacing:1px}
.whatsapp-float{position:fixed;right:22px;bottom:22px;width:52px;height:52px;border-radius:50%;display:grid;place-items:center;background:#21c66b;color:white;font-size:25px;z-index:40;box-shadow:0 5px 25px #0005}
@media(max-width:800px){
 .nav{gap:18px}.nav>a{font-size:11px}
 .intro-grid{grid-template-columns:1fr 2fr;gap:25px}.intro-note{grid-column:2}
 .contact-grid{gap:45px}
 .project-image{height:240px}
}
@media(max-width:650px){
 .container{width:min(100% - 36px,520px)}
 .header{height:72px}
 .brand-mark{width:37px;height:37px}
 .menu-toggle{display:flex;flex-direction:column;gap:5px;padding:10px;cursor:pointer}
 .menu-toggle span{width:23px;height:2px;background:var(--gold)}
 .nav{display:none;position:absolute;top:71px;left:0;right:0;background:#151513;padding:22px 24px 28px;flex-direction:column;align-items:stretch;gap:0;border-bottom:1px solid var(--line)}
 .nav.open{display:flex}
 .nav>a{padding:13px 0;border-bottom:1px solid var(--line)}
 .nav .nav-contact{margin-top:14px;text-align:center;padding:13px}
 .hero{height:700px;min-height:620px;max-height:calc(100svh - 72px)}
 .hero-bg{background-position:58% center}
 .hero h1{font-size:clamp(61px,15vw,83px);letter-spacing:-2px}
 .hero-text{font-size:13px;max-width:330px}
 .hero-actions{align-items:flex-start;flex-direction:column;gap:20px}
 .hero-bottom{bottom:-125px;font-size:7px;letter-spacing:1px}
 .hero-side-label{right:9px;font-size:7px}
 .section{padding:78px 0}
 .intro-grid{grid-template-columns:1fr;gap:25px}
 .intro-main h2,.section-heading h2{font-size:43px}
 .intro-note{grid-column:auto;display:none}
 .section-heading{display:block;margin-bottom:30px}
 .section-heading>p{margin-top:14px}
 .service-grid{grid-template-columns:1fr}
 .service-card{min-height:auto;padding:28px 25px;border-right:0;border-bottom:1px solid var(--line)}
 .service-card p{min-height:0}
 .service-icon{margin:5px 0 15px}
 .statement{height:390px}
 .statement h2{font-size:48px}
 .project-grid{grid-template-columns:1fr;gap:28px}
 .project-image{height:280px}
 .team-grid{grid-template-columns:1fr;gap:14px}
 .team-card{padding:22px;gap:17px}
 .team-avatar{width:62px;height:62px}
 .contact-grid{grid-template-columns:1fr;gap:25px}
 .contact h2{font-size:57px}
 .contact-details{padding-top:0}
 .footer-top{padding:27px 0;gap:22px;align-items:flex-start;flex-direction:column}
 .footer-bottom{padding:20px 0;gap:10px;align-items:flex-start;flex-direction:column}
}
@media(prefers-reduced-motion:reduce){
 html{scroll-behavior:auto}
 *,*:before,*:after{transition:none!important}
}

/* ===== UNIQUE GROUP LUXURY UPGRADE ===== */

:root {
  --gold: #d5b477;
  --gold-light: #f0d6a2;
}

::selection { background: var(--gold); color: #111; }

.hero-bg {
  background-image:
    linear-gradient(90deg,rgba(8,9,8,.94),rgba(8,9,8,.60) 48%,rgba(8,9,8,.12)),
    linear-gradient(0deg,rgba(8,9,8,.65),transparent 55%),
    url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2200&q=90');
  animation: heroReveal 1.3s ease both;
}

.hero h1 {
  text-shadow: 0 5px 35px #0007;
  animation: titleReveal 1s .15s both;
}

.hero-text { animation: titleReveal 1s .3s both; }
.hero-actions { animation: titleReveal 1s .45s both; }

@keyframes heroReveal {
  from { opacity:.5; transform:scale(1.06); }
  to { opacity:1; transform:scale(1); }
}
@keyframes titleReveal {
  from { opacity:0; transform:translateY(25px); }
  to { opacity:1; transform:translateY(0); }
}

/* Architectural project photography */
.project-one .project-image:before {
  background:
    linear-gradient(0deg,#10100f55,transparent 65%),
    url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1000&q=85') center/cover;
}
.project-two .project-image:before {
  background:
    linear-gradient(0deg,#10100f55,transparent 65%),
    url('https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1000&q=85') center/cover;
}
.project-three .project-image:before {
  background:
    linear-gradient(0deg,#10100f55,transparent 65%),
    url('https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1000&q=85') center/cover;
}

.project-image span {
  background:rgba(12,12,11,.48);
  backdrop-filter:blur(8px);
  border-color:rgba(255,255,255,.65);
  font-size:8px;
  letter-spacing:2px;
}

.project-card {
  transition:transform .4s ease;
}
.project-card:hover { transform:translateY(-7px); }

.service-card {
  overflow:hidden;
}
.service-card:after {
  content:"";
  position:absolute;
  left:0;bottom:0;
  width:0;height:2px;
  background:var(--gold);
  transition:width .4s ease;
}
.service-card:hover:after { width:100%; }
.service-icon { transition:transform .4s,color .4s; }
.service-card:hover .service-icon {
  transform:translateY(-5px) scale(1.08);
  color:var(--gold-light);
}

.team-card {
  transition:border-color .3s,transform .3s,background .3s;
}
.team-card:hover {
  border-color:var(--gold);
  background:#201e19;
  transform:translateY(-4px);
}
.team-avatar { transition:background .3s; }
.team-card:hover .team-avatar { background:#c8a66a16; }

.contact {
  position:relative;
  overflow:hidden;
}
.contact:after {
  content:"UG";
  position:absolute;
  right:-25px;bottom:-110px;
  font:300 300px var(--serif);
  color:#b18b5310;
  pointer-events:none;
}
.contact-grid { position:relative;z-index:1; }

.statement-bg {
  transition:transform 8s ease;
}
.statement:hover .statement-bg { transform:scale(1.04); }

.whatsapp-float {
  transition:transform .3s,box-shadow .3s;
  animation:whatsappPulse 2.8s infinite;
}
.whatsapp-float:hover {
  transform:scale(1.1);
  box-shadow:0 8px 30px #21c66b66;
}
@keyframes whatsappPulse {
  0%,100% { box-shadow:0 5px 25px #0005; }
  50% { box-shadow:0 5px 28px #21c66b55; }
}

.btn { position:relative;overflow:hidden; }
.btn span { transition:transform .3s; }
.btn:hover span { transform:translate(4px,-3px); }

.reveal {
  opacity:0;
  transform:translateY(28px);
  transition:opacity .8s ease,transform .8s ease;
}
.reveal.visible {
  opacity:1;
  transform:translateY(0);
}

@media(max-width:650px) {
  .hero-bg { background-position:60% center; }
  .project-image { height:300px; }
  .contact:after { font-size:180px; }
}
@media(prefers-reduced-motion:reduce) {
  .reveal,.hero-bg,.hero h1,.hero-text,.hero-actions {
    animation:none!important;
    opacity:1!important;
    transform:none!important;
    transition:none!important;
  }
  .whatsapp-float { animation:none!important; }
}

/* ===== MULTI-PAGE EXPERIENCE ===== */
.inner-hero {
  min-height:480px;
  display:flex;
  align-items:center;
  position:relative;
  overflow:hidden;
  background:
    linear-gradient(90deg,rgba(8,9,8,.94),rgba(8,9,8,.48)),
    var(--page-image) center/cover;
}
.inner-hero .container { position:relative;padding-top:35px;padding-bottom:35px; }
.inner-hero h1 {
  font:500 clamp(58px,8vw,90px)/1.08 var(--serif);
  margin:24px 0 15px;
  letter-spacing:-2px;
}
.inner-hero p { color:#d0ccc5;font-size:14px; }
.page-heading {
  font:500 clamp(38px,5vw,58px)/1.2 var(--serif);
  margin:20px 0 35px;
}
.page-heading em { color:var(--gold); }
.split-content {
  display:grid;
  grid-template-columns:1fr 1.2fr;
  gap:70px;
  align-items:start;
}
.page-copy { color:var(--muted);font-size:14px;line-height:2; }
.page-copy p { margin-bottom:20px; }
.page-copy .btn { margin-top:12px; }
.projects .project-image img {
  width:100%;height:100%;object-fit:cover;
  display:block;transition:transform .6s ease;
}
.projects .project-card:hover .project-image img { transform:scale(1.06); }
.enquiry-form {
  margin-top:30px;
  padding:25px;
  background:#171715;
  color:var(--white);
  display:grid;
  gap:17px;
}
.enquiry-form label {
  display:grid;gap:8px;
  font-size:10px;letter-spacing:1px;
  color:var(--gold);
}
.enquiry-form input,.enquiry-form select,.enquiry-form textarea {
  width:100%;padding:13px;
  border:1px solid #ffffff24;
  background:#22221f;color:white;
  font:13px var(--sans);
  border-radius:0;
  outline:none;
}
.enquiry-form input:focus,.enquiry-form select:focus,.enquiry-form textarea:focus {
  border-color:var(--gold);
}
.enquiry-form select option { background:#222;color:white; }
.enquiry-form textarea { resize:vertical; }
.enquiry-form .btn { border:0;cursor:pointer;justify-content:center; }
.form-note { color:#aaa69e;font-size:10px;line-height:1.6; }
@media(max-width:650px) {
  .inner-hero { min-height:410px; }
  .inner-hero h1 { font-size:64px; }
  .split-content { grid-template-columns:1fr;gap:15px; }
  .enquiry-form { padding:19px; }
}


/* ===== PREMIUM PROJECTS PORTFOLIO ===== */
.portfolio-active{color:var(--gold)!important}
.portfolio-hero{min-height:570px;position:relative;display:flex;align-items:center;overflow:hidden;background:#111}
.portfolio-hero-image{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,9,8,.94),rgba(8,9,8,.62) 52%,rgba(8,9,8,.18)),linear-gradient(0deg,rgba(8,9,8,.45),transparent),url('https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=2000&q=90') center/cover;animation:portfolioZoom 12s ease-in-out infinite alternate}
@keyframes portfolioZoom{from{transform:scale(1)}to{transform:scale(1.06)}}
.portfolio-hero-content{position:relative;padding:90px 0}
.portfolio-hero h1{font:500 clamp(65px,9vw,108px)/1.04 var(--serif);letter-spacing:-3px;margin:27px 0}
.portfolio-hero h1 em,.portfolio-intro h2 em,.portfolio-feature-copy h3 em,.portfolio-cta h2 em{color:var(--gold);font-weight:500}
.portfolio-hero-content>p{max-width:410px;color:#d0ccc5;font-size:14px;line-height:2;margin-bottom:28px}
.portfolio-vertical{position:absolute;right:28px;top:50%;writing-mode:vertical-rl;font-size:9px;letter-spacing:3px;color:#ffffff99}
.portfolio-intro{background:#eae7df;color:#171714;padding:85px 0}
.portfolio-intro-grid{display:grid;grid-template-columns:.8fr 2fr 1fr;gap:45px;align-items:start}
.portfolio-intro .section-label{color:#967747}
.portfolio-intro h2{font:500 clamp(32px,4.3vw,52px)/1.25 var(--serif)}
.portfolio-intro-grid>p{font-size:13px;color:#706d65;line-height:2;padding-top:8px}
.portfolio-gallery{background:#f0eee8;color:#171714}
.portfolio-gallery .section-label{color:#967747}
.portfolio-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:48px}
.portfolio-heading .page-heading{font:500 clamp(39px,5vw,58px)/1.2 var(--serif);margin-top:15px}
.portfolio-heading .page-heading em{color:#a27e48}
.portfolio-heading>p{max-width:290px;color:#77736c;font-size:12px;line-height:1.9}
.portfolio-feature{display:grid;grid-template-columns:1.55fr .8fr;gap:55px;align-items:center;margin-bottom:65px}
.portfolio-photo{height:440px;position:relative;overflow:hidden;background:#c9c5bb}
.portfolio-photo img,.portfolio-card-image img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
.portfolio-photo:hover img,.portfolio-card:hover img{transform:scale(1.055)}
.photo-index{position:absolute;bottom:20px;left:22px;background:#10100fc9;color:white;padding:10px 14px;font-size:9px;letter-spacing:2px}
.portfolio-feature-copy .section-label{font-size:9px}
.portfolio-feature-copy h3{font:500 clamp(38px,4.5vw,56px)/1.17 var(--serif);margin:22px 0}
.portfolio-feature-copy h3 em{color:#a27e48}
.portfolio-feature-copy>p{font-size:13px;line-height:2;color:#706d65;max-width:340px}
.portfolio-link{display:inline-flex;gap:20px;align-items:center;margin-top:30px;padding-bottom:9px;border-bottom:1px solid #b89a6b;font-size:9px;font-weight:700;letter-spacing:1.5px}
.portfolio-link span{color:#987747;font-size:17px}
.portfolio-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:42px 24px}
.portfolio-card{min-width:0}
.portfolio-card-image{height:320px;position:relative;overflow:hidden;background:#ccc}
.portfolio-card-image>span{position:absolute;right:16px;top:16px;background:#10100fc9;color:white;padding:9px 12px;font-size:10px;letter-spacing:1px}
.portfolio-card-info{padding:17px 0 0;border-bottom:1px solid #c9c5bb;padding-bottom:18px}
.portfolio-card-info small{font-size:9px;letter-spacing:1.8px;color:#987747}
.portfolio-card-info h3{font:500 25px var(--serif);margin-top:5px}
.portfolio-disclaimer{text-align:center;color:#827d73;font-size:10px;line-height:1.8;max-width:720px;margin:40px auto 0}
.portfolio-cta{padding:90px 0;background:#171715;position:relative;overflow:hidden}
.portfolio-cta:after{content:"UG";position:absolute;right:4%;bottom:-115px;font:300 300px var(--serif);color:#ffffff08;pointer-events:none}
.portfolio-cta-inner{display:flex;justify-content:space-between;align-items:center;gap:30px;position:relative;z-index:1}
.portfolio-cta .section-label{font-size:9px}
.portfolio-cta h2{font:500 clamp(42px,6vw,68px)/1.17 var(--serif);margin-top:18px}
.portfolio-cta .btn{flex-shrink:0}
@media(max-width:800px){
 .portfolio-intro-grid{grid-template-columns:1fr 2fr;gap:25px}
 .portfolio-intro-grid>p{grid-column:2}
 .portfolio-feature{gap:30px;grid-template-columns:1.2fr .8fr}
 .portfolio-photo{height:360px}
 .portfolio-card-image{height:270px}
}
@media(max-width:650px){
 .portfolio-hero{min-height:570px}
 .portfolio-hero-content{padding:75px 0}
 .portfolio-hero h1{font-size:clamp(62px,15vw,82px);letter-spacing:-2px}
 .portfolio-vertical{right:10px;font-size:7px}
 .portfolio-intro{padding:65px 0}
 .portfolio-intro-grid{grid-template-columns:1fr;gap:18px}
 .portfolio-intro h2{font-size:37px}
 .portfolio-intro-grid>p{grid-column:auto}
 .portfolio-heading{display:block;margin-bottom:30px}
 .portfolio-heading>p{margin-top:14px}
 .portfolio-feature{grid-template-columns:1fr;gap:25px;margin-bottom:45px}
 .portfolio-photo{height:290px}
 .portfolio-feature-copy h3{font-size:43px;margin:15px 0}
 .portfolio-grid{grid-template-columns:1fr;gap:30px}
 .portfolio-card-image{height:280px}
 .portfolio-card-info h3{font-size:23px}
 .portfolio-cta{padding:70px 0}
 .portfolio-cta-inner{align-items:flex-start;flex-direction:column}
 .portfolio-cta h2{font-size:47px}
 .portfolio-cta:after{font-size:180px;bottom:-65px}
}
@media(prefers-reduced-motion:reduce){
 .portfolio-hero-image{animation:none}
 .portfolio-photo img,.portfolio-card-image img{transition:none}
}


/* ===== UNIQUE GROUP PREMIUM ABOUT PAGE ===== */
.about-active{color:var(--gold)!important}
.about-hero{min-height:570px;position:relative;display:flex;align-items:center;overflow:hidden;background:#111}
.about-hero-bg{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,9,8,.95),rgba(8,9,8,.62) 52%,rgba(8,9,8,.16)),url('https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=2000&q=90') center/cover;animation:aboutHeroZoom 12s ease-in-out infinite alternate}
@keyframes aboutHeroZoom{from{transform:scale(1)}to{transform:scale(1.055)}}
.about-hero-content{position:relative;padding:90px 0}
.about-hero h1{font:500 clamp(65px,9vw,108px)/1.04 var(--serif);letter-spacing:-3px;margin:27px 0}
.about-hero h1 em,.about-story-main h2 em,.about-values-heading h2 em,.about-visual h2 em,.about-leadership h2 em,.about-contact-inner h2 em{color:var(--gold);font-weight:500}
.about-hero-content>p{max-width:420px;color:#d0ccc5;font-size:14px;line-height:2;margin-bottom:28px}
.about-hero-note{position:absolute;right:27px;bottom:35px;color:#ffffff99;font-size:9px;letter-spacing:3px;writing-mode:vertical-rl}
.about-story{padding:110px 0;background:#efede6;color:#191916}
.about-story-grid{display:grid;grid-template-columns:.8fr 2fr;gap:70px}
.about-story-label .section-label,.about-values .section-label,.about-visual .section-label,.about-leadership .section-label,.about-contact-strip .section-label{color:#987747}
.about-gold-line{width:48px;height:2px;background:#b18b53;margin:28px 0}
.about-small-note{font-size:9px;letter-spacing:2px;color:#89847a}
.about-story-main h2{font:500 clamp(40px,5vw,62px)/1.18 var(--serif);max-width:690px;margin-bottom:28px}
.about-story-main h2 em,.about-values-heading h2 em,.about-leadership h2 em{color:#a17d49}
.about-story-main p{max-width:650px;color:#706d65;font-size:13px;line-height:2;margin:0 0 17px}
.about-story-main .about-lead{font:500 19px/1.8 var(--serif);color:#39362f}
.about-text-link{display:inline-flex;gap:20px;margin-top:18px;padding-bottom:9px;border-bottom:1px solid #b89a6b;font-size:9px;font-weight:700;letter-spacing:1.5px}
.about-text-link span{color:#987747}
.about-values{padding:100px 0;background:#171715}
.about-values-heading{display:flex;justify-content:space-between;align-items:end;margin-bottom:45px}
.about-values-heading h2,.about-leadership h2{font:500 clamp(40px,5vw,58px)/1.2 var(--serif);margin-top:14px}
.about-values-grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line)}
.about-values-grid article{padding:35px 30px;min-height:220px;border-right:1px solid var(--line);transition:background .3s}
.about-values-grid article:last-child{border:0}
.about-values-grid article:hover{background:#211f19}
.about-values-grid article>span{font-size:10px;color:var(--gold);letter-spacing:2px}
.about-values-grid h3{font:500 23px var(--serif);margin:26px 0 12px}
.about-values-grid p{font-size:12px;color:var(--muted);line-height:1.9}
.about-visual{min-height:470px;position:relative;display:flex;align-items:center;overflow:hidden}
.about-visual-image{position:absolute;inset:0;background:linear-gradient(90deg,rgba(8,9,8,.94),rgba(8,9,8,.55)),url('https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1800&q=85') center/cover}
.about-visual-content{position:relative;padding:80px 0}
.about-visual h2{font:500 clamp(44px,6vw,70px)/1.18 var(--serif);margin:20px 0}
.about-visual-content>p{color:#d0ccc5;font-size:13px;margin-bottom:26px}
.about-leadership{padding:105px 0;background:#efede6;color:#191916}
.about-leadership-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:45px}
.about-leadership-heading>p{max-width:300px;color:#706d65;font-size:12px;line-height:1.9}
.about-leaders-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.about-leader{background:#191917;color:#f4f1eb;min-height:300px;padding:28px;display:flex;flex-direction:column;justify-content:space-between;transition:transform .35s,border-color .35s;border:1px solid #191917}
.about-leader:hover{transform:translateY(-6px);border-color:var(--gold)}
.about-leader-top{display:flex;justify-content:space-between;align-items:start}
.about-leader-top>span{font-size:9px;letter-spacing:2px;color:var(--gold)}
.about-leader-monogram{width:78px;height:78px;border:1px solid #c8a66a88;display:grid;place-items:center;font:500 31px var(--serif);color:var(--gold)}
.about-leader-bottom>span{font-size:9px;letter-spacing:1.7px;color:var(--gold)}
.about-leader-bottom h3{font:500 34px var(--serif);margin:7px 0 10px}
.about-leader-bottom>a{font-size:13px;color:#d4d0c8}
.about-leader-bottom>a b{color:var(--gold);margin-left:10px}
.about-contact-strip{padding:85px 0;background:#171715}
.about-contact-inner{display:flex;align-items:center;justify-content:space-between;gap:30px}
.about-contact-inner h2{font:500 clamp(42px,6vw,65px)/1.18 var(--serif);margin-top:17px}
@media(max-width:750px){
 .about-story-grid{gap:35px;grid-template-columns:.65fr 1.5fr}
 .about-values-grid article{padding:28px 20px}
}
@media(max-width:650px){
 .about-hero{min-height:540px}
 .about-hero-content{padding:75px 0}
 .about-hero h1{font-size:clamp(62px,15vw,82px);letter-spacing:-2px}
 .about-story{padding:75px 0}
 .about-story-grid{grid-template-columns:1fr;gap:22px}
 .about-story-main h2{font-size:42px}
 .about-values{padding:75px 0}
 .about-values-heading{display:block;margin-bottom:28px}
 .about-values-heading h2,.about-leadership h2{font-size:43px}
 .about-values-grid{grid-template-columns:1fr}
 .about-values-grid article{min-height:0;padding:27px 24px;border-right:0;border-bottom:1px solid var(--line)}
 .about-values-grid article:last-child{border-bottom:0}
 .about-visual{min-height:400px}
 .about-visual h2{font-size:48px}
 .about-leadership{padding:75px 0}
 .about-leadership-heading{display:block;margin-bottom:28px}
 .about-leadership-heading>p{margin-top:15px}
 .about-leaders-grid{grid-template-columns:1fr;gap:15px}
 .about-leader{min-height:260px;padding:24px}
 .about-contact-strip{padding:70px 0}
 .about-contact-inner{align-items:flex-start;flex-direction:column}
 .about-contact-inner h2{font-size:48px}
}
@media(prefers-reduced-motion:reduce){.about-hero-bg{animation:none}}
